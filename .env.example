# Environment values provide native-install defaults. Once saved in Settings,
# the locally stored values take precedence until reset in the app.
# Native hosting: the platform run scripts load .env.
# The standalone Docker Compose file uses fixed defaults and does not load .env.

# Native scripts use these host settings.
AUDIBLECALENDAR_BIND=127.0.0.1
AUDIBLECALENDAR_PORT=8000
# Optional reverse proxy: trust only its fixed IP or dedicated private subnet.
FORWARDED_ALLOW_IPS=127.0.0.1

# Local database and optional demo catalog.
AUDIBLECALENDAR_DB=.data/audiblecalendar.db
AUDIBLECALENDAR_DEMO_DATA=false

# Audible catalog defaults. Public search and sync do not require an account.
# Regions: us, uk, ca, au, de, fr, es, it, jp, in, br.
AUDIBLE_REGION=us
AUDIBLE_ENGLISH_ONLY=true
AUDIBLE_DATE_DISPLAY=us
# Leave blank to use the browser's time zone during a new installation's setup.
# Set an IANA zone here to use an explicit default instead.
AUDIBLE_TIME_ZONE=
AUDIBLE_DEFAULT_RELEASE_SCOPE=favourites
AUDIBLE_TIMEOUT=20
AUDIBLE_SYNC_PAGE_SIZE=50
AUDIBLE_SYNC_MAX_PAGES=8

# Optional Audnexus enrichment (enabled by default).
AUDNEXUS_ENABLED=true
AUDNEXUS_BASE_URL=https://api.audnex.us

# Compact header sync schedule (also available in Settings → App).
AUDIBLE_HEADER_SYNC_SUMMARY_VISIBLE=false
AUDIBLE_CLOSE_SETTINGS_ON_SAVE=true

# Automatic public-catalog sync. Authentication is not required.
AUDIBLE_AUTOMATIC_SYNC_ENABLED=true
AUDIBLE_SYNC_INTERVAL_HOURS=24
AUDIBLE_FAVOURITES_SYNC_ENABLED=false
AUDIBLE_FAVOURITES_SYNC_INTERVAL_HOURS=24

# Category-page defaults. The default ID is Science Fiction & Fantasy.
AUDIBLE_DEFAULT_CATEGORY_ID=18580606011
# Values: month_remaining or fixed.
AUDIBLE_DEFAULT_CATEGORY_WINDOW=month_remaining
AUDIBLE_DEFAULT_CATEGORY_DAYS=30

# Cache freshness windows. Manual and scheduled sync fetch fresh discovery
# pages but reuse product metadata. Ordinary modal/search reads respect these.
AUDIBLE_CACHE_DETAIL_MINUTES=120
AUDIBLE_CACHE_SEARCH_MINUTES=15
AUDIBLE_CACHE_AUTHOR_HOURS=24
AUDIBLE_CACHE_SERIES_HOURS=24
AUDIBLE_CACHE_UPCOMING_HOURS=6
AUDIBLE_CACHE_FAR_FUTURE_HOURS=168
AUDIBLE_CACHE_RELEASED_DAYS=3650
AUDIBLE_AUTHOR_MERGE_MIN_SHARED_SERIES=1

# Cache deletion and backup retention are controlled by the administrator in
# Settings → Cache for both native and Docker installations. Cleanup is on by default.
